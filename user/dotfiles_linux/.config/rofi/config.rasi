configuration {
    // wait for enter after running terminal command
    run-shell-command: "{terminal} -e bash -c '{cmd};echo -n [done];read'";

    sidebar-mode: true;
    combi-modi: "window,drun";
    modi: "window,pwr:~/.config/rofi/rofi-power-menu,combi";

    display-combi:   "";
    //display-calc:    "";
    display-window:  " ";
    display-drun:    " ";
    display-run:     " ";
    display-pwr:     "x ";

    pwr { display-name: ""; }


